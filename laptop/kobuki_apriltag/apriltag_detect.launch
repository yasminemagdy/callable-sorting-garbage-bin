
<launch>
  <node pkg="apriltag_ros" type="apriltag_ros_continuous_node" name="apriltag_ros_continuous_node" output="screen">
    <rosparam command="load" file="$(env HOME)/kobuki_apriltag/config/settings.yaml"/>
    <rosparam command="load" file="$(env HOME)/kobuki_apriltag/config/tags.yaml"/>

    <remap from="image_rect" to="/cam_synced/image_raw"/>
    <remap from="camera_info" to="/cam_synced/camera_info"/>

    <param name="camera_frame" type="str" value="orbbec_optical_frame"/>
    <param name="publish_tag_detections_image" type="bool" value="true"/>
    <param name="queue_size" type="int" value="20"/>
  </node>
</launch>
